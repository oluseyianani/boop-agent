# Replaces the trolley.oluseyi.dev block in /etc/caddy/Caddyfile.
#
# SECRET HYGIENE: the bcrypt hash lives ONLY in /etc/caddy/Caddyfile on the
# server. Never commit a real hash here — keep the placeholder.
#
# Layout:
# - /sendblue/webhook and /composio/webhook are PUBLIC (no basic auth): the
#   server verifies Sendblue's signature / Composio's HMAC itself and treats
#   exactly these paths as public (isPublicServerRequest).
# - /api/* mirrors the Vite dev proxy: prefix stripped, Origin and
#   X-Forwarded-* scrubbed so requests look local to Boop's guard (safe —
#   basic_auth has already gated the caller).
# - /ws is the WebSocket, same scrubbing.
# - Everything else: the static dashboard build.
#
# After editing: sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

trolley.oluseyi.dev {
	handle /sendblue/webhook {
		reverse_proxy localhost:3456
	}
	handle /composio/webhook {
		reverse_proxy localhost:3456
	}

	handle /api/* {
		basic_auth {
			oluseyi KEEP_EXISTING_HASH_HERE
		}
		uri strip_prefix /api
		reverse_proxy localhost:3456 {
			header_up Host localhost:3456
			header_up -Origin
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
		}
	}

	handle /ws {
		basic_auth {
			oluseyi KEEP_EXISTING_HASH_HERE
		}
		reverse_proxy localhost:3456 {
			header_up Host localhost:3456
			header_up -Origin
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
		}
	}

	handle {
		basic_auth {
			oluseyi KEEP_EXISTING_HASH_HERE
		}
		root * /home/oluseyi/apps/boop-agent/debug/dist
		try_files {path} /index.html
		file_server
	}
}
